# ================= Chay o may local =================
PORT=3000

# Cach 1 (local): khai bao roi rac
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=trucphuong
DB_PASSWORD=your_password
DB_NAME=websiteduoclieu

# Cach 2 (production): chuoi ket noi do nha cung cap cap.
# Co bien nay thi 5 bien DB_* o tren bi bo qua.
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Bat/tat SSL. Mac dinh: bat khi co DATABASE_URL, tat khi chay local.
# DB_SSL=true

# ================= Bao mat =================
# Sinh khoa moi cho production: openssl rand -hex 32
JWT_SECRET=thay_bang_chuoi_ngau_nhien_du_dai

# Domain cua frontend duoc phep goi API, cach nhau dau phay.
# De trong khi chay local (cho phep moi origin).
# FRONTEND_ORIGIN=https://ten-app.vercel.app

# ================= Cloudinary (upload anh) =================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
